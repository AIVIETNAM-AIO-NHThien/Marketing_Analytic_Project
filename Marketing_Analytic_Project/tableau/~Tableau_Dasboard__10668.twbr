    <worksheet name='Weighted ROI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet2 (Data_new_version)' name='federated.147e8r802g1cs71aa7atp0muwm84' />
          </datasources>
          <datasource-dependencies datasource='federated.147e8r802g1cs71aa7atp0muwm84'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Weighted ROI' datatype='real' name='[Calculation_0483265874055168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue]) / SUM([Total_Spend]) - 1' />
