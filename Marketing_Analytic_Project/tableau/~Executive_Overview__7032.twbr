      <aliases enabled='yes' />
      <column caption='Weighted ROI' datatype='real' name='[Calculation_0483265874055168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / SUM([Total_Spend]) - 1' />
      </column>
      <column caption='CPC' datatype='real' name='[Calculation_0483265874141185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total_Spend] / [Clicks]' />
      </column>
      <column caption='Weighted_CPA ' datatype='real' name='[Calculation_0483265874264066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spend]) /&#13;&#10;SUM([Conversions])' />
      </column>
      <column caption='PlaceHolder' datatype='integer' name='[Calculation_0483265898741763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='KPI_WeightedCPA' datatype='real' name='[Calculation_0483265912193028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spend]) / SUM([Conversions])' />
      </column>
      <column caption='Đối xứng âm' datatype='real' name='[Calculation_0483265919524869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- SUM([Measure Values])' />
      </column>
      <column caption='Platform' datatype='string' name='[Calculation_0483265956777990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Primary_Channel] = &apos;Instagram&apos; THEN &apos;Instagram&apos;&#13;&#10;ELSEIF [Primary_Channel] = &apos;Email&apos; THEN &apos;Email&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
